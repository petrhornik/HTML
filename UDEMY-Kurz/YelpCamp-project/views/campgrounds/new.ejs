<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vytvořit camp</title>
</head>
<body>
    <h1>Vytvořit Camp</h1>
    <form action="/campgrounds" method="POST">
        <div>
            <label for="title">Název: </label>
            <input type="text" id="title" name="campground[title]"> <!-- v name mám tzv. grouping, nejdřív dám název skupiny a potom do [] o co se jedná, v requestu se data potom budou sdružovat po název skupiny -->
        </div>
        <div>
            <label for="location">Lokalita: </label>
            <input type="text" id="location" name="campground[location]">
        </div>

        <button type="submit">Vytvořit Camp</button>
    </form>
    <a href="/campgrounds">Zpět na index Campů</a>
</body>
</html>