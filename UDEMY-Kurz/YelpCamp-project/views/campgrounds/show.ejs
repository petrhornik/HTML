<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail campu</title>
</head>
<body>
    <h1>Detail</h1>

    <section>
        <h2>Název: <%= camp.title %></h2>
        <p>Lokalita: <b><%= camp.location %></b></p>
    </section>
    <a href="/campgrounds">Zpět na Index</a>
    <a href="/campgrounds/<%= camp._id %>/edit">Upravit camp</a>
    <form action="/campgrounds/<%= camp._id %>?_method=DELETE" method="POST">
        <button>Smazat camp z DB</button>
    </form>
</body>
</html>