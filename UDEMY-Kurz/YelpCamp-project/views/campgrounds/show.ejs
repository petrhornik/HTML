<% layout("layouts/boilerplate") %>
<h1>Detail</h1>

<section class="d-flex border border-2 mt-4">
  <img
    class="img-fluid w-50"
    src="<%= camp.image %>"
    alt="<%= camp.description %>"
  />
  <div class="d-flex flex-column justify-content-between">
    <div class="m-2">
      <h2><%= camp.title %></h2>
      <p>Lokalita: <b><%= camp.location %></b></p>
      <p>Cena: <b><%= camp.price %> CZK/noc</b></p>
      <h4>Popisek:</h4>
      <p><%= camp.description %></p>
    </div>
    <div class="btn-group rounded-0">
      <a href="/campgrounds" class="btn btn-warning">Zpět na Index</a>
      <a href="/campgrounds/<%= camp._id %>/edit" class="btn btn-success"
        >Upravit camp</a
      >
      <form action="/campgrounds/<%= camp._id %>?_method=DELETE" method="POST">
        <button class="btn btn-danger rounded-0">Smazat camp z DB</button>
      </form>
    </div>
  </div>
</section>

<section class="mt-lg-3 d-flex flex-column align-items-center" id="review">
    <h2>Ohodnoťte nás...</h2>  
    <section class="d-flex gap-5 justify-content-center">
      <div>
    <div class="d-flex border border-2 mt-4" id="review-input">
      <form action="/campgrounds/<%= camp._id %>/reviews" method="POST" class="validatedForm" novalidate>
        <div class="p-3">
              <label class="form-label" for="rating">Míra hodnocení</label>
              <input class="form-range" type="range" id="rating" name="review[rating]" step="1" max="5" min="0">
        </div>
        <div class="p-3">
          <label class="form-label" for="body">Recenze</label>
          <textarea class="form-control" name="review[body]" id="body" rows="3" cols="30" required></textarea> <!-- zase používám grouping pro snažší rozlišení položek requestu -->
          <div class="valid-feedback">
            To by šlo :D
          </div>
        </div>
        <button class="btn btn-success m-3" >Odeslat</button>  
      </form>
    </div>
      </div>
    
    <div class="d-flex flex-column mt-4 w-75" id="review-dispaly">
      <% for (const review of camp.reviews){ %>
        <div class="p-2 m-3 card card-body">
          <p><%= review.body %></p>
          <p><%= review.rating %>/5</p>
          <form action="/campgrounds/<%= camp._id %>/reviews/<%= review._id %>/delete?_method=DELETE" method="POST">
            <button class="btn btn-sm btn-danger" >Smazat</button>
          </form>
        </div>
      <% } %>
    </div>
    </section>
</section>
