<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageName%></title>
</head>
<body>
    <h1>Vítejte na subredditu: <%= pageContent.name %></h1>
    <p>Počet sledujících => <%= pageContent.subscribers %></p>
    <p><b>Popis:</b> <%= pageContent.description %></p>

    <% for (let post of pageContent.posts) { %>
        <div class="post">
            <% if (post.img) { %>
                <img src=<%= post.img %> alt="" width="200px">
            <% } else { %>
                <p>Tento post neobsahuje obrázek či má neplatnou adresu :&#40;</p>
            <% } %>
            <div>
                <h3><%= post.title %></h3>
                <p><%= post.author %></p>
            </div>
        </div>
    <% } %>

    <style>
        .post{
            display: flex;
            width: 50%;
            text-align: center;
            gap: 10px;
            margin: 20px auto;
            justify-content: center;
            align-items: center;
        }
    </style>
</body>
</html>