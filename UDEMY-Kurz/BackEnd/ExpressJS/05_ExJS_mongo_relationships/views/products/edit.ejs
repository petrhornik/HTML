<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vytvořít nový produkt</title>
</head>
<body>
    <h1>Vytvořit nový produkt</h1>

    <form action="/products/<%= resultProduct._id %>/edit?_method=PUT" method="post">   <!-- form odesílá sice POST, ale díky query stringu a mothod-everride knihovně se to na BE převede na PUT request -->
        <div>
            <label for="name">Název: </label>
            <input type="text" name="name" value="<%= resultProduct.name %>" required>
        </div>
        <div>
            <label for="price">Cena: </label>
            <input type="number" name="price" min="0" value="<%= resultProduct.price %>" required>
        </div>
        <div>
            <label for="name">Kategorie: </label>
            <select name="category" id="category" required>
                <!-- <option value="fruit" <%= resultProduct.category == "fruit" && "selecter"%>>Ovoce</option>              pro určení selected z možností v editoru provedu pomocí zjednoduššeného ternary operátoru
                <option value="vegetable" <%= resultProduct.category == "vegetable" && "selected"%>>Zelenina</option>
                <option value="diary" <%= resultProduct.category == "diary" && "selected"%>>Mléčné</option> -->

                <% for (let item of categories) {%>                                                                     <!-- jednodušší a dynamičtější řešení -->
                    <option value="<%=item%>" <%= resultProduct.category === item && "selected" %>><%=item%></option>
                <% } %>
            </select>
        </div>
        <button>Submit</button>
    </form>
    <a href="/products/<%= resultProduct._id %>">Zpět na detail</a>
</body>
<style>
    div{
        margin: 0.5rem;
    }
</style>
</html>