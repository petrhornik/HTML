<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vytvořit novou farmu</title>
</head>
<body>
    <h1>Vytvořit novou farmu</h1>

    <form action="/farms/new" method="POST">
        <div>
            <label for="name">Název: </label>
            <input type="text" name="name" required min="3">
        </div>
        <div>
            <label for="city">Město: </label>
            <input type="text" name="city">
        </div>
        <div>
            <label for="email">E-mail: </label>
            <input type="email" name="email" placeholder="name@example.cz" required>
        </div>
        <button>Submit</button>
    </form>

    <a href="/farms">Zpět na index farem</a>

</body>
<style>
    div{
        margin: 0.5rem;
    }
</style>
</html>