<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index Produktů</title>
</head>
<body>
    <h1><%= category %> products</h1>

    <table>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>category</th>
            <th>detail</th>
        </tr>
        <% for (let product of products) {%>
            <tr>
                <td><%= product.name %></td>
                <td><%= product.price %></td>
                <td><%= product.category %></td>
                <td><a href="/products/<%= product._id %>">LINK</a></td>
            </tr>
        <% } %>
    </table>

    <a class="first" href="/products/new">Vytvořit produkt</a>
    <% if (category !== "All") {%>
        <a href="/products">Filter reset</a>
    <% } %>
</body>

<style>
    body{
        background-color: lightblue;
    }
    body>h1{
        color: rgb(191, 255, 0);
    }

    table{
          border: 1px solid black;
          text-align: center;
          background-color: black;
          box-shadow: 1px 1px 1px gray;
        }

    th, td {
        border: 1px solid black;
        background-color: white;
        font-size: 1.4rem;
        padding: 0.2rem;
    }
    th{
        color: red;
    }
    body>a{
        background-color: white;
        box-shadow: 1px 1px 1px black;
        margin-left: 0.5rem;
        padding: 1rem;
        font-weight: bold;
    }
    .first{
        margin-left: 20rem;
    }
</style>
</html>