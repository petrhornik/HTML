<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail produktu</title>
</head>
<body>
    <h1>Produkt detail</h1>

    <section>
        <h1><%= resultProduct.name %></h1>
        <hr>
        <p>Cena: <b><%= resultProduct.price %></b></p>
        <p>Kategorie: <a href="/products?category=<%= resultProduct.category %>"><b><%= resultProduct.category %></b></a></p>
    </section>

    <a class="move" href="/products">Zpět</a>
    <a href="/products/<%= resultProduct._id %>/edit">Editovat</a>
    <form action="/products/<%=resultProduct._id%>/delete?_method=DELETE" method="post">
        <button>Smazat!</button>
    </form>
</body>

<style>
    body{
        background-color: lightblue;
    }
    body>h1{
        color: rgb(191, 255, 0);
    }
    section{
        background-color: white;
        box-shadow: 1px 1px 1px gray;
        padding: 0.2rem;
        width: 10rem;
        text-align: center;
    }
    section h1{
        color: red;
    }

    body>a {
        background-color: white;
        box-shadow: 1px 1px 1px black;
        margin: 0.5rem;
        padding: 1rem;
        font-weight: bold;
    }
    body>a:hover{
        box-shadow: none;
    }
    .move{
        margin-left: 12rem; 
    }
    button {
        background-color: red;
        color: white;
        box-shadow: 1px 1px 1px black;
        margin: 0.5rem;
        padding: 1rem;
        font-weight: bold;
    }
    button:hover{
        box-shadow: none;
    }
</style>
</html>