<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
</head>
<body>

    <form action="/comments/<%= comment.id%>?_method=PATCH" method="post"> <!-- i když to vizera ako post tak díky method-override middlewaru to actually bude na BE registrovano ako PATCH -->
        <label for="comment">Upravit komentář: </label>
        <input type="text" value="<%= comment.comment%>" id="comment" name="comment">
        <button type="submit">Upravit</button>
    </form>
</body>
</html>