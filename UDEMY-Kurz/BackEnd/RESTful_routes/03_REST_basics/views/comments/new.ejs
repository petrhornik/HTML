<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create new comment</title>
</head>
<body>
    <h1>New comment</h1>
    <form action="/comments/new" method="post"> <!-- odkazuju se zpětně na index.js na post route u /comment/new -->
        <label for="username">Name: </label>
        <input type="text" max="10" min="3" id="username" name="username">
        <label for="comment">Comment: </label>
        <input type="text" max="40" min="5" id="comment" name="comment">
        <button type="submit">Odeslat</button>
    </form>

    <a href="/comments">Zpět na index komentářů</a>
</body>
</html>